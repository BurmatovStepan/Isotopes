{{#> Base
  title="Создание"
  pageClass="add"
}}
<form method="post" enctype="multipart/form-data" class="form">
  {{> Field
    class="form__name-field"
    label="Название изотопа"
    parameters=(hash
      type="text"
      name="name"
      id="isotope-name"
      placeholder="Название"
      value=name
      maxlength=20
      minlength=5
      required=""
    )
  }}

  {{> Field
    class="form__half-life-field"
    label="Период полураспада (сек.)"
    parameters=(hash
      type="number"
      name="halfLife"
      id="isotope-half-life"
      placeholder="Период в секундах"
      value=halfLife
      max=9007199254740991
      min=0
      required=""
    )
  }}

  {{> Textarea
    class="form__note-field"
    label="Примечание"
    value=note
    parameters=(hash
      name="note"
      id="isotope-note"
      placeholder="Примечание"
      maxlength=200
      required=""
    )
  }}

  {{> Field
    class="form__video-field"
    label="Видео"
    parameters=(hash
      type="file"
      name="video"
      id="isotope-video"
      accept="video/*"
      required=""
    )
  }}

  {{> Field
    class="form__image-field"
    label="Фото"
    parameters=(hash
      type="file"
      name="image"
      id="isotope-image"
      accept=".png, .jpg, .jpeg"
      required=""
    )
  }}

  <button class="form__submit" type="button">Сохранить</button>
</form>

{{> NavigationBar
  class="add__navigation"
  currentUrl="/add"
}}
{{/Base}}
