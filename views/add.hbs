{{#> Base
  title="Создание"
  pageClass="add"
}}
<form method="post" action="/isotopes/draft" enctype="multipart/form-data" class="form">
  <div class="form__media-wrapper">
    {{> Field
      class="form__video-field"
      label="Видео"
      parameters=(hash
        type="file"
        name="video"
        id="isotope-video"
        accept="video/*"
      )
    }}

    {{> IsotopeVideo
      videoUrl=fullVideoUrl
      options=(hash
        class="form__media-preview"
        controls=""
        muted=""
      )
    }}
  </div>

  <div class="form__media-wrapper">
    {{> Field
      class="form__image-field"
      label="Фото"
      parameters=(hash
        type="file"
        name="image"
        id="isotope-image"
        accept=".png, .jpg, .jpeg"
      )
    }}

    {{> IsotopeImage
      imageUrl=this.fullImageUrl
      options=(hash
        class="form__media-preview"
      )
    }}
  </div>

  <button class="form__submit" type="submit">Далее</button>
</form>

{{> NavigationBar
  class="add__navigation"
  currentUrl="/isotopes/add"
}}
{{/Base}}
