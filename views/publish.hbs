{{#> Base
  title="Публикация"
  pageClass="publish"
}}
<form method="post" action="/isotopes/{{id}}/publish" class="form">
  {{> Field
    class="form__half-life-field"
    label="Период полураспада (нс.)"
    parameters=(hash
      type="text"
      inputmode="numeric"
      pattern="[0-9]+"
      name="halfLife"
      id="isotope-half-life"
      placeholder="Период в наносекундах"
      value=halfLife
      maxlength=27
      required=""
    )
  }}

  <div class="form__radiation-type-field radiation-type">
    <span class="radiation-type__label">α-распад</span>
    <div class="radiation-type__control">
      <div class="radiation-type__prompt">Происходит α-распад</div>
      <div class="radiation-type__divider"></div>
      <input type="checkbox" name="isAlpha" class="radiation-type__input" {{#if isAlpha}}checked{{/if}}>
    </div>
  </div>

  {{> Textarea
    class="form__description-field"
    label="Описание"
    value=description
    parameters=(hash
      name="description"
      id="isotope-description"
      placeholder="Описание"
      maxlength=200
      required=""
    )
  }}

  <button class="form__submit" type="submit">Опубликовать</button>
</form>

{{> NavigationBar
  class="add__navigation"
  currentUrl="/isotopes/add"
}}
{{/Base}}
