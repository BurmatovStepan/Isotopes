{{#> Base
  title="Изотопы"
  pageClass="isotope"
}}

{{> IsotopeVideo
  videoUrl=fullVideoUrl
  options=(hash
    class="isotope__video"
    autoplay=""
    loop=""
    muted=""
  )
}}

<div class="isotope__overlay">
  <div class="isotope__meta meta">
    {{> Like
      class="meta__like"
      isLiked=isLiked
      likeCount=likeCount
    }}

    <div class="property-display {{radiationTypeClass}}">
      <img src="/icons/alpha.svg" class="property-display__label-icon">
      <div class="property-display__value">
        {{#if isAlpha}}
        <img src="/icons/check.svg" class="property-display__value-icon">
        {{else}}
        <img src="/icons/cross.svg" class="property-display__value-icon">
        {{/if}}
      </div>
    </div>

    <div class="property-display isotope__half-life" title="{{halfLifeFormatted.full}}">
      <div class="property-display__label">T&half;</div>
      <div class="property-display__value">{{halfLifeFormatted.compact}}</div>
    </div>

    <a href="/isotopes/home/{{id}}?next=true" class="meta__next next-button">
      <img src="/icons/chevrons-right.svg" class="next-button__icon">
    </a>
  </div>

  <div class="isotope__info">
    <h1 class="isotope__name">{{name}}</h1>

    <div class="isotope__description description">
      <p class="description__content">{{ description }}</p>

      <label class="description__action">
        <input type="checkbox" class="description__toggle">

        <div class="description__more">Подробнее</div>
        <div class="description__less">Скрыть</div>
      </label>
    </div>

  </div>

  {{> NavigationBar
    class="isotope__navigation"
    currentUrl="/isotopes/home"
  }}
</div>
{{/Base}}
