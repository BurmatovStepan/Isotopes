{{#> Base
  title="Изотопы"
  pageClass="isotope"
}}
<video class="isotope__video" src="{{fullVideoUrl}}" autoplay loop muted></video>

<div class="isotope__overlay">
  <div class="isotope__info">
    <h1 class="isotope__name">{{name}}</h1>

    {{> PropertyDisplay
      class="isotope__half-life"
      label="Период полураспада:"
      propertyValues=(array halfLifeFormatted)
    }}

    {{> PropertyDisplay
      class="isotope__radiation-type"
      label="Распад:"
      propertyValues=(pluck radiationTypes "name")
    }}

    <details class="isotope__description description" open>
      <summary class="description__summary">
        <h4 class="description__header">Описание</h4>
        <img src="/icons/chevron-down.svg" class="description__icon">
      </summary>
      <p class="description__content">{{description}}</p>
    </details>

  </div>

  <div class="isotope__actions actions">
    {{> Like
      class="actions__like"
      isLiked=isLiked
      likeCount=likeCount
    }}
    <a href="/home/{{id}}?next=true" class="actions__next next-button">
      Дальше
      <img src="/icons/chevrons-right.svg" class="next-button__icon">
    </a>
  </div>

  {{> NavigationBar
    class="isotope__navigation"
    currentUrl="/home"
  }}
</div>
{{/Base}}
