{{#> Base
  title="Коллекция"
  pageClass="grid"
}}
<section class="feed">
  <form method="get" class="feed__search search">
    {{> Field
      parameters=(hash
        type="number"
        name="maxHalfLife"
        value=maxHalfLife
        placeholder="Максимальный период полураспада в секундах"
        max=9007199254740991
        min=0
      )
    }}
  </form>

  <ul class="feed__list">
    {{#each isotopes}}

    <li class="feed__item">
      {{> IsotopeCard
        isotope=this
      }}
    </li>
    {{/each}}
  </ul>
</section>

{{> NavigationBar
  class="grid__navigation"
  currentUrl="/feed"
}}
{{/Base}}
