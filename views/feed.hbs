{{#> Base
  title="Коллекция"
  pageClass="feed"
}}
<section class="feed">
  <form method="get" class="feed__search search">
    {{> Field
      parameters=(hash
        type="text"
        inputmode="numeric"
        pattern="[0-9]+"
        name="maxHalfLife"
        id="isotope-half-life"
        placeholder="Максимальный период полураспада (нс.)"
        value=maxHalfLife
        maxlength=27
      )
    }}
  </form>

  <ul class="feed__list">
    {{#each isotopes}}

    <li class="feed__item">
      {{> IsotopeCard
        isotope=this
      }}
    </li>
    {{/each}}
  </ul>
</section>

{{> NavigationBar
  class="feed__navigation"
  currentUrl="/feed"
}}
{{/Base}}
