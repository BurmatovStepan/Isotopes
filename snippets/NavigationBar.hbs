<nav class="navigation {{class}}">
  <ul class="navigation__list">
    {{#each (paths)}}
    <li class="navigation__item {{#if (eq this.url ../currentUrl)}}navigation__item--active{{/if}}">
      <a href="{{this.url}}" class="navigation__link">
        <div style="--iconUrl: url({{this.imageUrl}})" class="navigation__icon"></div>
      </a>
    </li>
    {{/each}}
  </ul>
</nav>
